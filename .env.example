# Frontend (optional). Defaults to /api, which is right for `vercel dev` and production.
# VITE_API_BASE_URL=http://localhost:3000/api

# Backend (set these in the Vercel project; pull locally with `vercel env pull`)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
AUTHORIZED_ADMIN_EMAIL=you@example.com
VERCEL_APP_CLIENT_ID=your-vercel-app-client-id
VERCEL_APP_CLIENT_SECRET=your-vercel-app-client-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
